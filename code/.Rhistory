selected_data %>% summarize(t=sum(Data))
selected_data %>% filter(!is.na(Data)) %>% summarize(t=sum(Data))
ggplot(selected_data, aes(x = N_Poros_activos, y = Data, col = Cargas)) +
geom_point(size = 2) +
geom_hline(yintercept = c(10, 50), linetype = "dashed", color = "grey") +
theme_minimal(base_size = 15) + # Increase base font size
labs(
x = "# Active Pores",
y = "Gb",
col = "Loads" # Corrected the label for color legend
) +
theme(
axis.title = element_text(size = 14),
axis.text = element_text(size = 12),
legend.title = element_text(size = 14),
legend.text = element_text(size = 12),
plot.title = element_text(size = 16, face = "bold")
)
selected_data
cleaned_data <- selected_data %>%
filter(!is.na(N_Poros_activos) & !is.na(Data) & !is.na(DNA_ng_input) & !is.na(DNA_ng_output))
model <- lm(Data ~ N_Poros_activos + DNA_ng_input + DNA_ng_output + Cargas, data = cleaned_data)
# Display the summary of the linear model
summary(model)
# Handle missing values
cleaned_data <- selected_data %>%
filter(!is.na(N_Poros_activos) & !is.na(Data) & !is.na(DNA_ng_input) & !is.na(DNA_ng_output)) %>% filter(Data > 10)
# Create a linear model to explain the variability of Nanopore runs
# We will use N_Poros_activos, Rendimiento_libreria, DNA_ng_input, and DNA_ng_output as predictors
model <- lm(Data ~ N_Poros_activos + DNA_ng_input + DNA_ng_output + Cargas, data = cleaned_data)
# Display the summary of the linear model
summary(model)
cleaned_data
cleaned_data <- selected_data %>%
filter(!is.na(N_Poros_activos) & !is.na(Data) & !is.na(DNA_ng_input) & !is.na(DNA_ng_output)) %>% filter(N_Poros_activos > 3000)
# Create a linear model to explain the variability of Nanopore runs
# We will use N_Poros_activos, Rendimiento_libreria, DNA_ng_input, and DNA_ng_output as predictors
model <- lm(Data ~ N_Poros_activos + DNA_ng_input + DNA_ng_output + Cargas, data = cleaned_data)
# Display the summary of the linear model
summary(model)
