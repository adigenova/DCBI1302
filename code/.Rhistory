# Load the necessary packages
library(tidyverse)
# Create the dataframe
data <- tibble(
Genome = c("CHI01", "CHI02", "CHI09", "CHI10", "CHI12", "CHI15", "CHI16"),
Nanopore = c(99.79247277, 99.80603732, 99.8298963, 99.83649295, 99.79448589, 99.83912597, 99.31326301),
MGI = c(99.86872353, 99.86006495, 99.87864747, 99.86090985, 99.85213188, 99.87276086, 99.39938807)
)
# Reshape the dataframe for plotting
data_long <- data %>%
pivot_longer(cols = c(Nanopore, MGI), names_to = "Method", values_to = "Value")
# Find the minimum and maximum values for setting the y-axis limits
y_min <- min(data_long$Value) - 0.1
y_max <- max(data_long$Value) + 0.1
# Plot the dataframe with dynamic y-axis limits
ggplot(data_long, aes(x = Genome, y = Value, fill = Method)) +
geom_col(position="dodge2") +
labs(title = "Nanopore and MGI Genotypes", x = "Genome", y = "Concordance with genotype Array") +
coord_cartesian(ylim = c(99, 100)) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
#scale_y_continuous(limits = c(y_min, y_max))  # Adjust the y-axis limits dynamically
