angle":{"y":525.25622834072055,"x":77,"width":37.007999999999996,"height":40.696002960205078}},{"text":"Sed is a “non-interactive” stream-oriented editor. ","targetRectangle":{"y":564.30662837142881,"x":107,"width":398.08799999999991,"height":40.696002960205078}},{"text":"To automate editing actions to be performed on one or more files. ","targetRectangle":{"y":603.35702840213708,"x":107,"width":532.13400000000001,"height":40.696002960205078}},{"text":"To simplify the task of performing the same edits on multiple files. ","targetRectangle":{"y":642.40742843284534,"x":107,"width":531.14400000000001,"height":40.696002960205078}},{"text":"To write conversion programs. ","targetRectangle":{"y":681.4578284635536,"x":107,"width":247.67999999999995,"height":40.696002960205078}},{"text":"pasted-image.pdf","targetRectangle":{"y":195.41513061523438,"x":611.82171630859375,"width":419.84536743164062,"height":287.86990356445312}},{"text":"sed ’s\/2022\/2024\/g’ file.txt","targetRectangle":{"y":568.0335111618042,"x":664.62042236328125,"width":190.27200000000005,"height":17.552001953125}},{"text":"sed ’s\/2022\/2024\/g ; s\/casa\/home\/g’ file.txt","targetRectangle":{"y":586.0335111618042,"x":664.62042236328125,"width":310.88000000000011,"height":17.552001953125}},{"text":"awk ‘{print $1}’ file.txt","targetRectangle":{"y":622.0335111618042,"x":664.62042236328125,"width":155.26400000000001,"height":17.552001953125}},{"text":"awk ‘{print $1}’ *.txt","targetRectangle":{"y":640.0335111618042,"x":664.62042236328125,"width":140.46400000000006,"height":17.552001953125}},{"text":"awk ‘\/perro\/ {print $0}’ *.txt","targetRectangle":{"y":658.0335111618042,"x":664.62042236328125,"width":193.20000000000005,"height":17.552001953125}},{"text":"Sed and Awk —- Power tools for editing files","targetRectangle":{"y":115.25811004638672,"x":59,"width":809.09599999999966,"height":44.897735595703125}},{"text":"Linux","targetRectangle":{"y":38.666667938232422,"x":59,"width":148.14360010621547,"height":71