02432250976562,"width":69.23583984375,"height":26}},{"text":"cake","targetRectangle":{"y":319.00000190734863,"x":156.02432250976562,"width":55.388671875,"height":26}},{"text":"banana","targetRectangle":{"y":345.00000190734863,"x":156.02432250976562,"width":83.0830078125,"height":26}},{"text":"# print lines only if the last field is a negative number","targetRectangle":{"y":397.00000190734863,"x":156.02432250976562,"width":789.28857421875,"height":26}},{"text":"# recall that the default action is to print the contents of $0","targetRectangle":{"y":423.00000190734863,"x":156.02432250976562,"width":872.37158203125,"height":26}},{"text":"$ awk '$NF<0' table.txt","targetRectangle":{"y":449.00000190734863,"x":156.02432250976562,"width":318.48486328125,"height":26}},{"text":"blue cake mug shirt -7","targetRectangle":{"y":475.00000190734863,"x":156.02432250976562,"width":304.6376953125,"height":26}},{"text":"# change 'b' to 'B' only for the first field","targetRectangle":{"y":527.00000190734863,"x":156.02432250976562,"width":609.275390625,"height":26}},{"text":"$ awk '{gsub(\/b\/, \\\"B\\\", $1)} 1' table.txt","targetRectangle":{"y":553.00000190734863,"x":156.02432250976562,"width":553.88671875,"height":26}},{"text":"Brown bread mat hair 42","targetRectangle":{"y":579.00000190734863,"x":156.02432250976562,"width":318.48486328125,"height":26}},{"text":"Blue cake mug shirt -7","targetRectangle":{"y":605.00000190734863,"x":156.02432250976562,"width":304.6376953125,"height":26}},{"text":"yellow banana window shoes 3.14","targetRectangle":{"y":631.00000190734863,"x":156.02432250976562,"width":429.26220703125,"height":26}},{"text":"awk 'cond1{action1} cond2{action2} ... condN{actionN}'","targetRectangle":{"y":665.27563333511353,"x":231.83912658691406,"width":650.21484375,"height":40}},{"text":"https:\/\/learnbyexample.github.io\/learn_gnuawk\/","targetRectangle":{"y":705.33335846662521,"x":168.72499370574951,"width":686.54999999999995,"height":36.129791259765625}},{"text":"Awk","